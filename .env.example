# Copy to .env and adjust. All application variables use the PDFMASTER_ prefix.
# setup_windows.bat creates .env with a random secret key for you.

PDFMASTER_ENVIRONMENT=development          # development | production
# REQUIRED in production, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PDFMASTER_SECRET_KEY=

# Database. Default (when unset): SQLite file in storage/pdfmaster.db
# PostgreSQL example: postgresql+psycopg://pdfmaster:CHANGE_ME@localhost:5432/pdfmaster
# PDFMASTER_DATABASE_URL=

# Frontend hosting. Leave CORS empty when the API serves the frontend itself (default).
# For a separately hosted frontend list its origin(s), comma separated, and set frontend/assets/js/config.js.
PDFMASTER_SERVE_FRONTEND=true
PDFMASTER_CORS_ORIGINS=

# Cookies: set SECURE=true behind HTTPS. A frontend on a different site also needs SAMESITE=none.
PDFMASTER_COOKIE_SECURE=false
PDFMASTER_COOKIE_SAMESITE=strict

# Limits
PDFMASTER_MAX_UPLOAD_MB=100
PDFMASTER_MAX_PAGES=5000
PDFMASTER_AUTH_RATE_LIMIT_PER_MINUTE=10
PDFMASTER_REGISTRATION_ENABLED=true

# docker-compose only
POSTGRES_PASSWORD=
